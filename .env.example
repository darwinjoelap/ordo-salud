# Copia este archivo como .env (NO se sube a git)
SECRET_KEY=cambia-esto-por-una-clave-larga
# Local: vacío = SQLite. Para PostgreSQL local:
# DATABASE_URL=postgres://usuario:clave@localhost:5432/ordo_salud
DATABASE_URL=

# Archivos en Cloudflare R2 (ADR-051). Vacío R2_BUCKET = carpeta media/ local.
# En tu PC: depósito y token «ordo-salud-dev». En Railway: «ordo-salud-media» y token «ordo-salud-prod».
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_URL_EXPIRA=3600        # segundos que vale un enlace firmado (logos, firmas, banners)

# ── Solo en Railway ─────────────────────────────────────────
# DJANGO_SETTINGS_MODULE=config.settings.prod
# ALLOWED_HOSTS=ordo-salud-staging.up.railway.app
# CSRF_TRUSTED_ORIGINS=https://ordo-salud-staging.up.railway.app
# Subdominio por consultorio (ADR-049, después del ~31/10; ver docs/DESPLIEGUE_RAILWAY.md):
# BASE_DOMAIN=salud.ordove.com
# ALLOWED_HOSTS=.salud.ordove.com,ordo-salud-staging.up.railway.app,healthcheck.railway.app
# CSRF_TRUSTED_ORIGINS=https://*.salud.ordove.com,https://ordo-salud-staging.up.railway.app
# SENTRY_DSN=
# SECURE_HSTS_SECONDS=3600

# ── Dictado de la consulta con IA (ADR-045/046) ── sin clave funciona en modo de prueba
GEMINI_API_KEY=
# DICTADO_PROVEEDOR=gemini            # gemini (predeterminado) | openai_claude
# DICTADO_MODELO_GEMINI=gemini-3.8-flash
# DICTADO_RAZONAMIENTO=low           # minimal | low | medium | high (más alto = más lento)
# Alternativa (no disponible desde Venezuela):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DICTADO_MODO=prueba
# DICTADO_MODELO_TRANSCRIPCION=gpt-4o-transcribe
# DICTADO_MODELO_IA=claude-sonnet-5-5
